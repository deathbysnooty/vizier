/target
.data/
.vizier/
*.vizier*
*.agent.md
.env*

# webui build artifacts
webui/node_modules/
webui/build/
webui/.vite/
webui/.react-router/


# quiz bank: downloaded third-party dumps, fetch cache and fact-check logs stay local
quizbank/api/

# movie bank: the stills are downloaded third-party dumps and run to hundreds of
# megabytes. The bank names them; a workspace that hasn't got them simply asks
# with tags and hint lines instead.
moviebank/images/

# place bank: the same, and more so - the street photos are the whole game, so
# a workspace without them keeps Geo switched off rather than posting a card
# with nothing on it. Rebuild them with geobank/tools/harvest.py, or rsync them
# to the server beside movies.json.
geobank/images/
moviebank/tools/source_quiz.sqlite
quizbank/wikidata/.cache/
quizbank/reviews/
__pycache__/
